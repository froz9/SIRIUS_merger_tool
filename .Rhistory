img(src = "logo_L125.png", height = "200px", style = "margin-right: 20px;"),
h2("SIRIUS Output Analyzer", style = "font-size: 80px; font-weight: bold; margin: 0;")
),
hr(),
sidebarLayout(
sidebarPanel(
